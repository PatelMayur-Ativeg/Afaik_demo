<odoo>
    <data noupdate="0">
        <record id="email_template_for_approve_budget" model="mail.template">
            <field name="name">Budget: Approve Order</field>
            <field name="model_id" ref="custom_aafa.model_budget_analytic" />
            <field name="subject">Submit for Budget Approval</field>
            <field name="email_from"></field>
            <field name="email_to"></field>

            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <h2>
                            <b>Submit for Approval:<t t-out="object.name"/></b>
                        </h2>
                        <br />
                        <br />
                        <p>
                            Dear Approver,
                            <br />
                            <br />
                            This is inform you that budget is created and waiting for approval in your stage, kindly check and approve it accordingly.
                            <br />
                            <b>User:</b>
                            <t t-out="object.user_id.name"/>
                            <br />
                            <b>Total Amount:</b>
                            <t t-out="object.sum_planned_amount"/>
                            <!-- <t t-out="format_amount(object.amount_total, object.currency_id"/> -->

                            <br />
                            <b>Approval Level:</b>
                            <t t-out="object.label_name"/>
                            <!-- <t t-out="
                                dict(self._fields['label_name'].selection).get(self.label_name)"/> -->
                            <br />
                            <br />
                        </p>
                        <br />
                        <br />
                        
                        As you are authorize approver as per approval level.<br />
                        You can use the following link and approve the order<br /><br />

                        <div style="display: inline-block; margin: 15px; text-align: center">
                            
                            <a t-attf-href="/web?#id={{ object.id }}&amp;view_type=form&amp;model=budget.analytic" target="_blank"
                                style="padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px"
                            >Order Ref: <t t-out="object.name"/></a>
                        </div><br />
                        Thanks.
                    </p>
                </div>
            </field>
        </record>

